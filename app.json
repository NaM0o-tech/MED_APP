{
  "expo": {
    "name": "Time Med",
    "slug": "time-med",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/time_med.png",
    "scheme": "medapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/time_med.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.namo.timemed"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "086aaace-e8ff-43f9-a75c-7f463a34e98f"
      }
    }
  }
}
